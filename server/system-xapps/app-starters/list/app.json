        "personal_utility",
        "list_or_tracker",
        "record_management"
      ],
      "_entry_view": "main",
      "_adaptation_strategy": {
        "_mode": "none",
        "_summary": "The reusable list shell is already a valid host for primary-experience composition and does not require a separate starter cleanup phase."
      },
      "_primary_experience": {
        "_mode": "host-existing-experience",
        "_required": [
          "_entry_view_id",
          "_content_container_id",
